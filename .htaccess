# J&Ko Ventures — server configuration

# --- keep private things private --------------------------------------------
# The content store, the password hash and the PHP includes must never be
# served directly, whatever anyone types in the address bar.
RedirectMatch 404 ^/(data|inc)(/|$)

<Files "enquiries.log">
  Require all denied
</Files>
<FilesMatch "\.(json|log)$">
  Require all denied
</FilesMatch>

# --- default charset --------------------------------------------------------
AddDefaultCharset UTF-8

# --- clean URLs -------------------------------------------------------------
RewriteEngine On

# /about -> about.php
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^([A-Za-z0-9_-]+)/?$ $1.php [L]

# old .html links keep working
RewriteCond %{THE_REQUEST} \s/+([A-Za-z0-9_-]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# never expose the .php extension
RewriteCond %{THE_REQUEST} \s/+([A-Za-z0-9_-]+)\.php[\s?] [NC]
RewriteCond %{REQUEST_URI} !^/(admin|form-handler)
RewriteRule ^ /%1 [R=301,L]

# --- compression ------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- caching ----------------------------------------------------------------
# Everything here is cached hard, so REPLACING ANY FILE IN PLACE REQUIRES
# BUMPING ASSET_V in inc/content.php - otherwise returning visitors keep the
# old copy (a month for css/js, a YEAR for images) and never see the change.
# Photos uploaded through the admin panel get a fresh filename each time, so
# they are not affected.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css            "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/svg+xml       "access plus 1 year"
  ExpiresByType image/jpeg          "access plus 1 year"
  ExpiresByType image/png           "access plus 1 year"
  ExpiresByType image/webp          "access plus 1 year"
  ExpiresByType text/html           "access plus 0 seconds"
</IfModule>

# --- basic security headers -------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  # the admin panel should never be indexed or framed
  <If "%{REQUEST_URI} =~ m#^/admin#">
    Header set X-Robots-Tag "noindex, nofollow"
  </If>
</IfModule>

# --- uploaded files are data, never code ------------------------------------
<Directory "assets/img/uploads">
  php_flag engine off
</Directory>

ErrorDocument 404 /404.php
